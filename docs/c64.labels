# Labels/annotations for dis6502 (-l docs/c64.labels).
# Format: ADDR NAME [; comment]   or   ADDR-END .data NAME [; comment]
# Addresses refer to the decrypted image (extracted/c64mem.bin).

# ---- loader / protection (tape only, not part of the game) ----
0FCA prot_wipe          ; RESTORE/NMI + tamper handler: wipes $1000-$FFFF
0FE8 prot_decrypt       ; k += step; mem ^= k for X pages at ($FB)
1000 loader_entry       ; SYS 4096: decrypt $1100 page, RTS into it
1100 loader_stage2      ; decrypt $1A00-$1DFF, LOAD game, decrypt $7E00/$8000, JMP $7E00
1A00 loader_screen      ; loading screen setup
7E00 prot_stage3        ; self-decrypting check: device $BA=1, PLAY sense, no drives 8-15
7F8C-7FD3 .data prot_msg ; "DISCONNECT ANY OTHER PERIPHERALS EXCEPT CASSETTE UNIT AND RELOAD."

# ---- game (cartridge-style image $8000-$BFFF) ----
8000-8008 .data cbm80_header ; cold/warm vectors -> $8009, "CBM80"
8009 game_cold_start    ; S=$FF, NMI->$90DB, CIA IRQs off, clear ZP/screen
8169 init_sub_8169
8290 build_sprites      ; expand 1-bit shapes from ($22) into MC sprites at ($24), 64 B each
82BC build_one_sprite
8CFD copy_7_every_3     ; copies 7 bytes into every 3rd byte (sprite column fill)
90DB nmi_handler        ; RESTORE key handling
97CB irq_main           ; raster IRQ: ECM colour splits, bottom-row split, then ALL game logic
9882 irq_logic          ; per-frame game update calls start here
9E9B wait_5_frames
9EA4 wait_frame         ; $4D = 1, wait until IRQ clears it
9EAD wait_x_times_5

# ---- main loop / timers ----
8154 main_loop          ; JSR 877A,91AD,8339,8F75,98ED,9A83 forever
8339 timers_run         ; $0820 table: 8 x [reload, count, lo, hi]; count==0 -> reload + JMP (cb), returns to $8369
836E timers_tick        ; IRQ: decrement each nonzero count
85D5 unk_85D5
8A6E timer_cb_8A6E
8A9A timer_cb_8A9A
9A22 timer_cb_9A22
9A33 timer_cb_9A33
9A5D timer_cb_9A5D
9F44 timer_cb_9F44
9F45 timer_cb_9F45
8B45 timer_cb_8B45      ; cycle chars $38-$3F in row $0680 (animated band)
9F4F unk_9F4F
9F62-9F81 .data timer_init ; copied to $0820 at cold start

